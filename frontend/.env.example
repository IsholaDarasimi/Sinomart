# Copy this file to .env.local and fill in your actual project values.
# Never commit .env.local. Only VITE_-prefixed variables are exposed to the browser bundle —
# never put PAYSTACK_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, or SMTP credentials here.

# Supabase project (find these in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack PUBLIC key only — the secret key lives in Supabase Edge Function secrets,
# never in frontend code (see supabase/functions/_shared/paystack.ts).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
